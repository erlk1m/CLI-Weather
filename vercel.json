{
  "framework": null,
  "builds": [
    {
      "src": "api/**/*.rs",
      "use": "@vercel/rust"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/weather",
      "destination": "/api/weather.rs"
    }
  ]
}
